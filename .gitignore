# TLC scratch
states/
*.st
# build output
/bin/

# Cargo build output. This was committed by the initial `git add -A` when the
# Rust corner was vendored, which meant every cargo build dirtied the tree and
# buried real changes under thousands of artefact diffs.
impls/rust/target/

# Negation-canary checkpoint. Resumable working state, not evidence --
# the completed sweep is written to negation-canaries.json.
evidence/runs/gobra/*.jsonl

# Agent worktrees. Ephemeral checkouts created by Agent isolation; the work
# they hold lands as pushed branches, never as files here.
.claude/worktrees/
